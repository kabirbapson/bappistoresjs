# 5000 is often taken by macOS AirPlay Receiver — use 5001 if you see EADDRINUSE
PORT=5001
# Browser address: http://bappistores:5001 (after CONFIGURE-HOSTNAME.bat once on Windows)
APP_HOST=bappistores

# Built-in database (recommended on shop PCs). Data folder: data/mongodb
# Or install MongoDB Community and use:
# MONGO_URI=mongodb://127.0.0.1:27017/bappistores
MONGO_URI=

# Built-in MongoDB engine version (Windows shop PCs)
MONGOMS_VERSION=7.0.14
# First start timeout (ms) — default 10s is too short after download; use 300000 (5 min)
MONGOMS_STARTUP_TIMEOUT=300000

JWT_SECRET=change-this-secret
SEED_ADMIN_EMAIL=admin@bappi.com
SEED_ADMIN_PASSWORD=admin123

# Required to delete customers, invoices (sales), or debt records
DELETE_PASSWORD=Bappi@123
