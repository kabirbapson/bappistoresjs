# Production (START.bat / npm run start): API on same host — do not change
VITE_API_URL=/api

# Local hostname — http://bappistores:5001 (run CONFIGURE-HOSTNAME once per PC)
VITE_APP_HOST=bappistores

# Dev only (npm run dev): Vite proxy target — must match PORT in server/.env
DEV_PROXY_TARGET=http://127.0.0.1:5001
