# Dev: full URL if not using Vite proxy. Production build (npm run start): use /api
VITE_API_URL=/api

# Local hostname (http://bappistores:5001) — run CONFIGURE-HOSTNAME once per PC
VITE_APP_HOST=bappistores

# Dev only: where Vite proxies /api (must match server PORT in server/.env)
DEV_PROXY_TARGET=http://127.0.0.1:5001
